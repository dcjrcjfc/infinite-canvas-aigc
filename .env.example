# Node.js 22.16+. Copy to .env; empty keys keep models disabled.
HOST=127.0.0.1
PORT=8787
# Required for non-loopback HOST; HTTPS reverse proxy needs PUBLIC_ORIGIN.
APP_PASSWORD=
PUBLIC_ORIGIN=
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=33554432
UPSTREAM_TIMEOUT_MS=180000
# Default task metadata directory: .local/ (never publish).
DATA_DIR=

# Existing image integrations. The provider's .cn site redirects to .org.
IMAGE_API_BASE=https://ai.t8star.org
NANOBANANA_API_KEY=
NANOBANANA_MODEL=gemini-3.1-flash-image-preview-4k
NANOBANANA_API_STYLE=openai
GPT_IMAGE_2_API_KEY=
GPT_IMAGE_2_MODEL=gpt-image-2
# Per-model *_API_BASE and *_API_STYLE override shared settings.
# Use aspect-ratio only for endpoints accepting aspect_ratio + image_size.
# The following require full supplier model IDs and compatible images endpoints.
# Native /mj and native Jimeng protocols are not interchangeable with this adapter.
MIDJOURNEY_API_KEY=
MIDJOURNEY_MODEL=
MIDJOURNEY_API_BASE=
JIMENG_API_KEY=
JIMENG_MODEL=
JIMENG_API_BASE=

# Chat Completions-compatible Agent; exact supplier model IDs are required.
AGENT_API_BASE=https://ai.t8star.org
AGENT_API_KEY=
GEMINI_MODEL=
CHATGPT_MODEL=
DEEPSEEK_MODEL=
# Optional dedicated GEMINI_API_KEY / CHATGPT_API_KEY / DEEPSEEK_API_KEY
# and *_API_BASE override shared Agent settings.

# Video protocols: openai or json-task. Match your supplier's documented schema.
VIDEO_API_BASE=https://ai.t8star.org
VIDEO_API_KEY=
VIDEO_API_STYLE=openai
SEEDANCE_MODEL=
KLING_MODEL=
# Optional dedicated SEEDANCE_API_KEY / KLING_API_KEY, *_API_BASE, *_API_STYLE.
# json-task defaults (paths do not change the JSON request schema):
# VIDEO_CREATE_PATH=/v1/video/generations
# VIDEO_QUERY_PATH=/v1/video/generations/{id}
# Per-model *_CREATE_PATH / *_QUERY_PATH override shared paths.

# Audio. speech uses an OpenAI-compatible binary /v1/audio/speech endpoint.
# Configure the exact supplier model and supported voices before real acceptance.
AUDIO_API_BASE=https://api.openai.com
AUDIO_API_KEY=
AUDIO_MODEL=
AUDIO_API_STYLE=speech
AUDIO_CREATE_PATH=/v1/audio/speech
# json-audio explicitly sends {model,prompt,voice,speed} and requires a synchronous
# {audio_url}, {url}, or {b64_json} result. It is not a universal music API.

# Advanced video capabilities: only enable combinations confirmed by your supplier.
# These values are exposed to the client and validated before submitting a task.
# VIDEO_RATIOS=16:9,9:16
# VIDEO_DURATIONS=4,8,12
# VIDEO_INPUT_MODES=first-frame
# VIDEO_MAX_REFERENCES=1
# VIDEO_RESOLUTIONS=720p
# json-task can explicitly configure first-last-frame/reference, up to 4 images,
# 1-60 second durations, and 480p/720p/1080p. Its create schema adds input_mode
# and resolution. Native supplier payloads may require a separate adapter.
# Per-model SEEDANCE_* / KLING_* override these VIDEO_* capability fields.

# Image production capabilities: enable only after checking your provider contract.
# Prefixes: NANOBANANA, GPT_IMAGE_2, MIDJOURNEY, JIMENG.
# Default max outputs is 1. Multi-image responses preserve every returned candidate (up to 4).
# GPT_IMAGE_2_MAX_OUTPUTS=4
# GPT_IMAGE_2_MASK_EDITING=true
# Mask edits use /v1/images/edits multipart image + PNG mask, transparent area = edit.
# Optional operator-supplied per-request estimate, not provider billing or an actual charge.
# GPT_IMAGE_2_PRICE_PER_REQUEST=0.10
# GPT_IMAGE_2_PRICE_CURRENCY=USD
# The same *_PRICE_PER_REQUEST and *_PRICE_CURRENCY fields work for all model prefixes.
# Shared projects and hashed invitation capabilities persist under DATA_DIR/shared-projects.
# Invites expire after 7 days; editing uses optimistic revision checks. No external cloud is provisioned.
